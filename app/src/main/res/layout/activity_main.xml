<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/axisight_marker">

    <!-- ── Camera surfaces (full-bleed, letterboxed on black) ─────────────── -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance" />

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/usbCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.etrsystems.axisight.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/reticle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_reticle"
        android:visibility="gone" />

    <!-- ── Chrome ─────────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOP BAR: camera source + settings -->
        <LinearLayout
            android:id="@+id/topStrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/axisight_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rgCameraSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:checkedButton="@id/rbInternal"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbInternal"
                    style="@style/Widget.AxiSight.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/internal"
                    app:icon="@drawable/ic_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbUsb"
                    style="@style/Widget.AxiSight.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usb"
                    app:icon="@drawable/ic_usb" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rbWifi"
                    style="@style/Widget.AxiSight.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wifi"
                    app:icon="@drawable/ic_wifi" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.AxiSight.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/btn_settings_desc"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>

        <!-- WIFI ROW: only when WiFi is the source -->
        <LinearLayout
            android:id="@+id/wifiGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/axisight_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topStrip"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/wifi_url_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edWifiUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnWifiConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/connect" />
        </LinearLayout>

        <!-- ZOOM: bottom-end, above the action bar -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/zoomGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:checkedButton="@id/btnZoom1x"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom1x"
                style="@style/Widget.AxiSight.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/zoom_1x" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom2x"
                style="@style/Widget.AxiSight.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/zoom_2x" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom5x"
                style="@style/Widget.AxiSight.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/zoom_5x" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- READOUT CARD: offset + quality, top-start under the bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deltaCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/axisight_scrim"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wifiGroup"
            app:layout_constraintWidth_default="wrap"
            app:layout_constraintWidth_max="420dp"
            app:strokeColor="@color/axisight_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/readout_title"
                    android:textAppearance="@style/TextAppearance.AxiSight.Section" />

                <TextView
                    android:id="@+id/txtDelta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/delta_uncalibrated"
                    android:textColor="@color/axisight_text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/txtQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/quality_no_signal"
                    android:textColor="@color/axisight_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtParams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/params_summary_initial"
                    android:textColor="@color/axisight_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SETTINGS PANEL: hidden until the tune button is tapped -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tuningPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/axisight_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHeight_max="440dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="520dp"
            app:strokeColor="@color/axisight_outline"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tuning_title"
                            android:textColor="@color/axisight_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTuningClose"
                            style="@style/Widget.AxiSight.Button.Icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/btn_close_desc"
                            app:icon="@drawable/ic_close" />
                    </LinearLayout>

                    <!-- Mode switches -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/auto"
                        android:textColor="@color/axisight_text" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sim"
                        android:textColor="@color/axisight_text" />

                    <!-- Target circle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/section_target"
                        android:textAppearance="@style/TextAppearance.AxiSight.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/label_target_radius">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edTargetRadius"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRadiusMinus"
                            style="@style/Widget.AxiSight.Button.Icon.Tonal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/btn_radius_minus_desc"
                            app:icon="@drawable/ic_remove" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRadiusPlus"
                            style="@style/Widget.AxiSight.Button.Icon.Tonal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/btn_radius_plus_desc"
                            app:icon="@drawable/ic_add" />

                        <!-- Nudge pad -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNudgeUp"
                                style="@style/Widget.AxiSight.Button.Icon.Tonal"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:contentDescription="@string/btn_nudge_up_desc"
                                app:icon="@drawable/ic_arrow_up" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNudgeLeft"
                                    style="@style/Widget.AxiSight.Button.Icon.Tonal"
                                    android:layout_width="40dp"
                                    android:layout_height="36dp"
                                    android:contentDescription="@string/btn_nudge_left_desc"
                                    app:icon="@drawable/ic_arrow_left" />

                                <Space
                                    android:layout_width="40dp"
                                    android:layout_height="36dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNudgeRight"
                                    style="@style/Widget.AxiSight.Button.Icon.Tonal"
                                    android:layout_width="40dp"
                                    android:layout_height="36dp"
                                    android:contentDescription="@string/btn_nudge_right_desc"
                                    app:icon="@drawable/ic_arrow_right" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNudgeDown"
                                style="@style/Widget.AxiSight.Button.Icon.Tonal"
                                android:layout_width="40dp"
                                android:layout_height="36dp"
                                android:contentDescription="@string/btn_nudge_down_desc"
                                app:icon="@drawable/ic_arrow_down" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Detection thresholds -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/section_detection"
                        android:textAppearance="@style/TextAppearance.AxiSight.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_circularity"
                            android:textColor="@color/axisight_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCircVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/axisight_ring"
                            android:textSize="13sp"
                            tools:text="0.65" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        app:tickVisible="false"
                        app:trackStopIndicatorSize="0dp"
                        android:id="@+id/seekCirc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.01"
                        android:value="0.65"
                        android:valueFrom="0"
                        android:valueTo="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_kstd"
                            android:textColor="@color/axisight_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtKstdVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/axisight_ring"
                            android:textSize="13sp"
                            tools:text="1.50" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        app:tickVisible="false"
                        app:trackStopIndicatorSize="0dp"
                        android:id="@+id/seekKstd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.05"
                        android:value="1.5"
                        android:valueFrom="0"
                        android:valueTo="3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_contrast"
                            android:textColor="@color/axisight_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtContrastVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/axisight_ring"
                            android:textSize="13sp"
                            tools:text="0.12" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        app:tickVisible="false"
                        app:trackStopIndicatorSize="0dp"
                        android:id="@+id/seekContrast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.01"
                        android:value="0.12"
                        android:valueFrom="0"
                        android:valueTo="0.5" />

                    <!-- Scale -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/section_scale"
                        android:textAppearance="@style/TextAppearance.AxiSight.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="@string/label_mm_per_px">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edMmPerPx"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/label_known_mm">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edKnownMm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="numberDecimal"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- CALIBRATION PANEL: shown while the wizard runs -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/calibrationPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/axisight_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="520dp"
            app:strokeColor="@color/axisight_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calibration_panel_title"
                    android:textAppearance="@style/TextAppearance.AxiSight.Section"
                    android:textColor="@color/axisight_accent" />

                <TextView
                    android:id="@+id/txtCalStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/calibration_step_center"
                    android:textColor="@color/axisight_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtCalCapture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/calibration_step_wait_tap"
                    android:textColor="@color/axisight_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtCalQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="monospace"
                    android:text="@string/calibration_quality_pending"
                    android:textColor="@color/axisight_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCalAutoCenter"
                    style="@style/Widget.AxiSight.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/calibration_auto_center"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnCalRotationCapture"
                    style="@style/Widget.AxiSight.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/calibration_rotation_start"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCalConfirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.2"
                        android:text="@string/calibration_confirm" />

                    <Button
                        android:id="@+id/btnCalRetry"
                        style="@style/Widget.AxiSight.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/calibration_retry" />

                    <Button
                        android:id="@+id/btnCalCancel"
                        style="@style/Widget.AxiSight.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/calibration_cancel" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTTOM ACTION BAR -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/axisight_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCal"
                style="@style/Widget.AxiSight.Button.Bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calibrate"
                app:icon="@drawable/ic_calibrate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrack"
                style="@style/Widget.AxiSight.Button.Bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_pause"
                app:icon="@drawable/ic_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackReset"
                style="@style/Widget.AxiSight.Button.Bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_reset"
                app:icon="@drawable/ic_restart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLock"
                style="@style/Widget.AxiSight.Button.Bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lock"
                app:icon="@drawable/ic_lock_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.AxiSight.Button.Bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export"
                app:icon="@drawable/ic_export" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
